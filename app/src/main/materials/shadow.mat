material {
    name : TiltClockShadow,
    shadingModel : unlit,
    blending : transparent,
    shadowMultiplier : true,
    doubleSided : true
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.0, 0.0, 0.0, 0.25);
    }
}
